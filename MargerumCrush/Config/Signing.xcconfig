// Signing for the MargerumCrush target only (not the CrushKit package, which
// rejects provisioning profiles). Local builds use automatic signing: pick
// your team in Xcode. The TestFlight workflow (testflight-crush.yml) writes
// Signing.local.xcconfig from GitHub secrets to switch to manual App Store
// signing; that file is gitignored and never committed.
CODE_SIGN_STYLE = Automatic
CRUSH_CODE_SIGN_IDENTITY = Apple Development

#include? "Signing.local.xcconfig"
